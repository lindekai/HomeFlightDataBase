# Vorlage – kopieren nach .env und ausfüllen. .env niemals committen.

# --- Datenbank (PostGIS) ---
POSTGRES_DB=flightdb
POSTGRES_USER=flightdb_admin
POSTGRES_PASSWORD=change-me
# Nur lesende Rolle für n8n und Grafana
DB_READONLY_USER=flightdb_reader
DB_READONLY_PASSWORD=change-me

# --- Speicherorte auf dem NAS ---
DB_DATA_DIR=/volumeX/docker/flightdb/postgres
RAW_ARCHIVE_DIR=/volumeY/flightdb/raw

# --- Empfangsstation ---
RECEIVER_HOST=receiver.local
RECEIVER_SSH_USER=flightdb
RECEIVER_DATA_DIR=/var/lib/flightdb/raw
# Vorhaltezeit auf dem Pi nach bestätigter Archivierung (Tage)
RECEIVER_RETENTION_DAYS=7

# --- Empfängerstandort (nur lokal, für Analyse) ---
RECEIVER_LAT=
RECEIVER_LON=
RECEIVER_ALT_M=
