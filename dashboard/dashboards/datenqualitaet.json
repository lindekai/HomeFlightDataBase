          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT * FROM ingest_status"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 6
    },
    {
      "type": "table",
      "title": "Analyse-Läufe",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flightdb"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT id, kind AS \"Art\", status, started_at AS \"Beginn\", finished_at AS \"Ende\",\n  window_from AS \"von\", window_to AS \"bis\", n_flights AS \"Flüge\", n_events AS \"Überflüge\",\n  n_skipped AS \"übersprungen\", error AS \"Fehler\"\nFROM analysis_runs ORDER BY id DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 7
    }
  ]
}
