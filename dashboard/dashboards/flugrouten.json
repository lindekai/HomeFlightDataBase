    {
      "type": "table",
      "title": "Prüffälle",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flightdb"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT a.ref_ts AS \"Zeit\", f.callsign AS \"Rufzeichen\", p.kind || ' ' || p.name AS \"Verfahren\",\n  a.confidence AS \"Sicherheit\", round(a.max_dev_m) AS \"max. Abw. m\",\n  round(a.outside_s) AS \"außerhalb s\",\n  concat_ws(', ', CASE WHEN a.deviation THEN 'Abweichung' END,\n    CASE WHEN a.approach THEN 'Annäherung' END) AS \"Gründe\",\n  'Flugspur' AS \"Flugspur\", a.flight_id,\n  (extract(epoch FROM f.first_ts) * 1000)::bigint AS t_from,\n  (extract(epoch FROM f.last_ts) * 1000)::bigint AS t_to\nFROM flight_assessments a\nJOIN flights f ON f.id = a.flight_id\nJOIN procedures p ON p.id = a.procedure_id\nWHERE \n  $__timeFilter(a.ref_ts)\n  AND p.name IN ($procedure)\n  AND (a.confidence = 'high'\n       OR (a.confidence = 'medium' AND '$confidence' <> 'nur hoch')\n       OR '$confidence' = 'alle')\n  AND (a.review OR '$only_review' = 'nein') AND a.review\nORDER BY a.ref_ts DESC LIMIT 200"
        }
      ],
