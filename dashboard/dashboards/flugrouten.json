      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT p.kind || ' ' || p.name AS \"Verfahren\", count(*) AS \"Flüge\",\n  round(100.0 * count(*) FILTER (WHERE a.deviation) / count(*)) AS \"Abw. %\",\n  round(percentile_cont(0.5) WITHIN GROUP (ORDER BY a.max_dev_m)) AS \"Median m\",\n  round(percentile_cont(0.95) WITHIN GROUP (ORDER BY a.max_dev_m)) AS \"95 % m\"\nFROM flight_assessments a JOIN procedures p ON p.id = a.procedure_id\nWHERE \n  $__timeFilter(a.ref_ts)\n  AND p.name IN ($procedure)\n  AND (a.confidence = 'high'\n       OR (a.confidence = 'medium' AND '$confidence' <> 'nur hoch')\n       OR '$confidence' = 'alle')\n  AND (a.review OR '$only_review' = 'nein')\nGROUP BY p.kind, p.name ORDER BY count(*) DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 6
    },
    {
      "type": "geomap",
      "title": "Ideallinien, Korridor, Spuren",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flightdb"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT p.name AS procedure, ST_Y(d.geom) AS latitude, ST_X(d.geom) AS longitude\nFROM procedures p,\n  LATERAL ST_DumpPoints(ST_Segmentize(p.geom::geography, 200)::geometry) d\nWHERE p.superseded_at IS NULL AND p.name IN ($procedure)\n  AND p.valid_from <= ($__timeTo())::timestamptz::date\n  AND (p.valid_to IS NULL OR p.valid_to > ($__timeFrom())::timestamptz::date)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT p.name AS procedure, ST_Y(d.geom) AS latitude, ST_X(d.geom) AS longitude\nFROM procedures p,\n  LATERAL ST_DumpPoints(ST_Segmentize(ST_ExteriorRing(\n    ST_Buffer(p.geom::geography, coalesce((SELECT (params->>'corridor_m')::float8 FROM analysis_runs\n    WHERE status = 'ok' ORDER BY id DESC LIMIT 1), 1852))::geometry)::geography, 200)::geometry) d\nWHERE p.superseded_at IS NULL AND p.name IN ($procedure)\n  AND p.valid_from <= ($__timeTo())::timestamptz::date\n  AND (p.valid_to IS NULL OR p.valid_to > ($__timeFrom())::timestamptz::date)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH sel AS (\n  SELECT a.flight_id FROM flight_assessments a JOIN procedures p ON p.id = a.procedure_id\n  WHERE \n  $__timeFilter(a.ref_ts)\n  AND p.name IN ($procedure)\n  AND (a.confidence = 'high'\n       OR (a.confidence = 'medium' AND '$confidence' <> 'nur hoch')\n       OR '$confidence' = 'alle')\n  AND (a.review OR '$only_review' = 'nein') AND a.review = false\n  ORDER BY a.ref_ts DESC LIMIT 100\n)\nSELECT f.id AS flight_id, ST_Y(d.geom) AS latitude, ST_X(d.geom) AS longitude\nFROM flights f JOIN sel ON sel.flight_id = f.id, LATERAL ST_DumpPoints(f.track) d\nWHERE d.path[1] % 5 = 1"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH sel AS (\n  SELECT a.flight_id FROM flight_assessments a JOIN procedures p ON p.id = a.procedure_id\n  WHERE \n  $__timeFilter(a.ref_ts)\n  AND p.name IN ($procedure)\n  AND (a.confidence = 'high'\n       OR (a.confidence = 'medium' AND '$confidence' <> 'nur hoch')\n       OR '$confidence' = 'alle')\n  AND (a.review OR '$only_review' = 'nein') AND a.review = true\n  ORDER BY a.ref_ts DESC LIMIT 100\n)\nSELECT f.id AS flight_id, ST_Y(d.geom) AS latitude, ST_X(d.geom) AS longitude\nFROM flights f JOIN sel ON sel.flight_id = f.id, LATERAL ST_DumpPoints(f.track) d\nWHERE d.path[1] % 5 = 1"
        }
      ],
