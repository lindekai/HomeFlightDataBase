          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE a.confidence IN ('high', 'medium'))\n  / nullif(count(*), 0) AS \"%\"\nFROM flight_assessments a WHERE $__timeFilter(a.ref_ts)"
