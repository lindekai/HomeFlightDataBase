    {
      "type": "table",
      "title": "Je Verfahren",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flightdb"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
