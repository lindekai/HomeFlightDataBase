      "id": 1
    },
    {
      "type": "table",
      "title": "Überflüge dieses Flugs",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flightdb"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 10,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT g.name AS \"Zone\", e.entry_ts AS \"Eintritt\", e.exit_ts AS \"Austritt\",\n  e.min_alt_ft AS \"Höhe ft\", round(e.min_dist_m) AS \"Abstand m\", e.heading_sector AS \"Richtung\",\n  e.category AS \"Kategorie\", e.category_basis::text AS \"Begründung\"\nFROM overflight_events e JOIN geofences g ON g.id = e.geofence_id\nWHERE e.flight_id = nullif(${flight_id:sqlstring}, '')::bigint ORDER BY e.entry_ts"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Höhe und Geschwindigkeit",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flightdb"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT p.ts AS time, p.alt_baro_ft AS \"Höhe ft\", p.gs_kt AS \"Geschwindigkeit kt\"\nFROM positions p JOIN flights f ON p.icao24 = f.icao24\n  AND p.ts BETWEEN f.first_ts AND f.last_ts\nWHERE f.id = nullif(${flight_id:sqlstring}, '')::bigint ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 3
    },
    {
      "type": "table",
      "title": "Bewertung (Flugroutenvergleich)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flightdb"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT a.role AS \"Rolle\", a.direction AS \"Betriebsrichtung\", a.flight_sector AS \"Sektor\",\n  p.kind || ' ' || p.name AS \"Verfahren\", a.confidence AS \"Sicherheit\",\n  round(a.max_dev_m) AS \"max. Abw. m\", round(a.outside_s) AS \"außerhalb s\",\n  a.deviation AS \"Abweichung\", a.approach AS \"Annäherung\", a.review AS \"Prüffall\",\n  array_to_string(a.review_reasons, ', ') AS \"erfüllt\", a.basis AS \"Begründung\"\nFROM flight_assessments a LEFT JOIN procedures p ON p.id = a.procedure_id\nWHERE a.flight_id = nullif(${flight_id:sqlstring}, '')::bigint"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 4
    }
  ]
}
