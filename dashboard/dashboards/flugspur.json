  "links": [],
  "panels": [
    {
      "type": "geomap",
      "title": "Spur",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flightdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 14,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ST_Y(d.geom) AS latitude, ST_X(d.geom) AS longitude,\n  to_timestamp(ST_M(d.geom)) AS time\nFROM flights f, LATERAL ST_DumpPoints(f.track) d\nWHERE f.id = nullif(${flight_id:sqlstring}, '')::bigint ORDER BY d.path"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ST_Y(d.geom) AS latitude, ST_X(d.geom) AS longitude\nFROM procedures p,\n  LATERAL ST_DumpPoints(ST_Segmentize(p.geom::geography, 200)::geometry) d\nWHERE p.id = (SELECT procedure_id FROM flight_assessments WHERE flight_id = nullif(${flight_id:sqlstring}, '')::bigint)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ST_Y(d.geom) AS latitude, ST_X(d.geom) AS longitude\nFROM procedures p,\n  LATERAL ST_DumpPoints(ST_Segmentize(ST_ExteriorRing(\n    ST_Buffer(p.geom::geography, coalesce((SELECT (params->>'corridor_m')::float8 FROM analysis_runs\n    WHERE status = 'ok' ORDER BY id DESC LIMIT 1), 1852))::geometry)::geography, 200)::geometry) d\nWHERE p.id = (SELECT procedure_id FROM flight_assessments WHERE flight_id = nullif(${flight_id:sqlstring}, '')::bigint)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "view": {
          "id": "fit",
          "allLayers": true,
          "padding": 10
