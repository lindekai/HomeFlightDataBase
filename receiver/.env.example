# Vorlage – kopieren nach receiver/.env und ausfüllen. .env niemals committen.
# Enthält den genauen Standort: Datei nur auf dem Pi, chmod 600.

RECEIVER_ID=rx1

# --- Standort der Antenne (WGS84, Höhe über NN in Metern) ---
FEEDER_LAT=
FEEDER_LON=
FEEDER_ALT_M=
# Anzeigename für MLAT: nur Buchstaben, Ziffern, - und _ (keinen Ortsnamen verwenden)
FEEDER_NAME=

# --- SDR ---
SDR_SERIAL=
# true für RTL-SDR Blog V4 mit LNA an der Antenne
SDR_BIASTEE=false

# --- recorder ---
RECORDER_DATA_DIR=/srv/flightdb/data
RECORDER_UID=1000
RECORDER_GID=1000
RECEIVER_RETENTION_DAYS=7
RECORDER_NTP_SERVER=pool.ntp.org

# --- Einspeisung (Profil "feeders") ---
ADSBLOL_UUID=
FR24_KEY=
PIAWARE_FEEDER_ID=
OPENSKY_USERNAME=
# Nach dem ersten Start aus dem Log übernehmen, sonst entsteht bei jedem Start ein neuer Feeder
OPENSKY_SERIAL=
